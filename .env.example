# ==============================================================================
# Banking Chatbot Backend - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Enterprise Banking Chatbot API"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# OPTION 1: Azure OpenAI Service (Recommended for Azure Web App)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Use API Key authentication:
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# OR use Azure Managed Identity (Set to true when running on Azure App Service with Managed Identity):
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# ------------------------------------------------------------------------------
# OPTION 2: Standard OpenAI API (Direct OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION 3: Offline / Demo Mock Engine
# ------------------------------------------------------------------------------
# Set to true to force offline rule-based mock engine for testing without LLM API costs
MOCK_LLM_MODE=false

# ------------------------------------------------------------------------------
# AGENT 2 (ANALYZER): Azure AI Search Configuration
# ------------------------------------------------------------------------------
# Your Azure AI Search Service URL (e.g. https://your-search-service.search.windows.net)
AZURE_SEARCH_ENDPOINT=
# Your Azure AI Search Admin or Query API Key:
AZURE_SEARCH_API_KEY=
# Your Azure AI Search Index Name:
AZURE_SEARCH_INDEX_NAME=
# Index field mapping (customizable to match your index schema):
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_TITLE_FIELD=title
AZURE_SEARCH_CATEGORY_FIELD=category
AZURE_SEARCH_TOP_K=5
AZURE_SEARCH_USE_MANAGED_IDENTITY=false

# ------------------------------------------------------------------------------
# AGENT 2 (ANALYZER): Cross-Encoder Reranker Configuration
# ------------------------------------------------------------------------------
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=3
ENABLE_CROSS_ENCODER=true