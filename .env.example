# ==============================================================================
# Banking Chatbot Backend - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Enterprise Banking Chatbot API"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# OPTION 1: Azure OpenAI Service (Recommended for Azure Web App)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Use API Key authentication:
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# OR use Azure Managed Identity (Set to true when running on Azure App Service with Managed Identity):
AZURE_OPENAI_USE_MANAGED_IDENTITY=false

# ------------------------------------------------------------------------------
# OPTION 2: Standard OpenAI API (Direct OpenAI)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION 3: Offline / Demo Mock Engine
# ------------------------------------------------------------------------------
# Set to true to force offline rule-based mock engine for testing without LLM API costs
MOCK_LLM_MODE=false
